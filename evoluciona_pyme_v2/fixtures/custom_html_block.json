  "doctype": "Custom HTML Block",
  "html": "<style>\n.ep-dash { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }\n.ep-header { background: linear-gradient(135deg, #1a3a4a 0%, #005f6b 60%, #0a8f9e 100%); color: white; padding: 20px 28px; border-radius: 14px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 6px 24px rgba(0,95,107,0.35); }\n.ep-header h2 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.5px; }\n.ep-header p { margin: 2px 0 0; font-size: 11px; opacity: 0.75; text-transform: uppercase; letter-spacing: 1.5px; }\n.ep-badge { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); border-radius: 50px; padding: 6px 18px; text-align: center; backdrop-filter: blur(6px); }\n.ep-badge span { display: block; font-size: 10px; opacity: 0.8; text-transform: uppercase; letter-spacing: 1px; }\n.ep-badge strong { font-size: 26px; font-weight: 800; }\n.ep-section { background: white; border-radius: 12px; padding: 18px; height: 100%; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden; }\n.ep-section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 14px; display: flex; align-items: center; gap: 6px; }\n.ep-btn-main { display: block; width: 100%; padding: 10px 14px; border: none; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; margin-bottom: 8px; transition: opacity .15s; }\n.ep-btn-main:hover { opacity: 0.87; }\n.ep-btn-sm { display: block; width: 100%; padding: 7px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; margin-bottom: 5px; text-align: left; transition: all .15s; border: none; }\n.ep-btn-sm:hover { filter: brightness(0.95); }\n.ep-btn-outline { display: block; width: 100%; padding: 9px 10px; border-radius: 7px; font-size: 12px; font-weight: 600; cursor: pointer; margin-bottom: 6px; text-align: center; transition: all .15s; border: 2px solid; background: white; }\n.ep-btn-outline:hover { color: white !important; }\n.ep-btn-outline.verde  { border-color: #27ae60; color: #27ae60; } .ep-btn-outline.verde:hover  { background: #27ae60; }\n.ep-btn-outline.rojo   { border-color: #e74c3c; color: #e74c3c; } .ep-btn-outline.rojo:hover   { background: #e74c3c; }\n.ep-btn-outline.morado { border-color: #8e44ad; color: #8e44ad; } .ep-btn-outline.morado:hover { background: #8e44ad; }\n.ep-btn-outline.naranja{ border-color: #e67e22; color: #e67e22; } .ep-btn-outline.naranja:hover{ background: #e67e22; }\n.ep-divider { border: none; border-top: 1px dashed #e8e8e8; margin: 12px 0; }\n.ep-tag { display: inline-block; font-size: 9px; font-weight: 700; border-radius: 4px; padding: 2px 6px; text-transform: uppercase; letter-spacing: 0.5px; vertical-align: middle; }\n.ep-f29-strip { display: flex; gap: 4px; margin-bottom: 12px; border-radius: 8px; overflow: hidden; height: 8px; }\n.ep-f29-strip div { flex: 1; }\n.ep-dev { margin-top: 18px; background: #1e2d3d; border-radius: 12px; padding: 16px; }\n.ep-dev-title { color: #7fb3c8; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; border-bottom: 1px solid #2d3f50; padding-bottom: 8px; margin-bottom: 10px; }\n.ep-dev table { width: 100%; border-collapse: collapse; }\n.ep-dev td { padding: 5px 4px; color: #94a3b8; font-size: 11px; }\n.ep-dev td:first-child { color: #cbd5e1; font-weight: 500; }\n.ep-dev tr:hover td { background: rgba(255,255,255,0.03); }\n.ep-dev-btn { padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; cursor: pointer; border: none; }\n</style>\n\n<div class=\"ep-dash\">\n\n  <!-- HEADER -->\n  <div class=\"ep-header\">\n    <div>\n      <h2>&#9698; EVOLUCIONA PYME</h2>\n      <p>Control Contable &amp; Tributario</p>\n    </div>\n    <div style=\"text-align:center;\">\n      <div class=\"ep-badge\">\n        <span>Clientes Activos</span>\n        <strong id=\"ep-txt-total-clientes\">&#8230;</strong>\n      </div>\n    </div>\n  </div>\n\n  <!-- BANDA DE COLOR F29 (visual indicator) -->\n  <div class=\"ep-f29-strip\" title=\"Colores del F29 SII\">\n    <div style=\"background:#1a3a8f;\"></div>\n    <div style=\"background:#27ae60;\"></div>\n    <div style=\"background:#f39c12;\"></div>\n    <div style=\"background:#e74c3c;\"></div>\n    <div style=\"background:#8e44ad;\"></div>\n    <div style=\"background:#005f6b;\"></div>\n    <div style=\"background:#1a3a8f;\"></div>\n    <div style=\"background:#27ae60;\"></div>\n    <div style=\"background:#f39c12;\"></div>\n    <div style=\"background:#e74c3c;\"></div>\n  </div>\n\n  <!-- CUERPO -->\n  <div class=\"row\">\n\n    <!-- COLUMNA 1: CLIENTES -->\n    <div class=\"col-md-3\" style=\"padding:0 6px;\">\n      <div class=\"ep-section\" style=\"border-top: 4px solid #005f6b;\">\n        <div class=\"ep-section-title\" style=\"color:#005f6b;\">\n          <i class=\"fa fa-users\"></i> Clientes\n        </div>\n        <button onclick=\"window.location.href='/app/ficha_cliente'\" class=\"ep-btn-main\" style=\"background:linear-gradient(135deg,#005f6b,#0a8f9e);color:white;\">\n          <i class=\"fa fa-id-card\"></i> Fichas de Clientes\n        </button>\n        <hr class=\"ep-divider\">\n        <button onclick=\"window.location.href='/app/vencimiento_cliente'\" class=\"ep-btn-sm\" style=\"background:#fff3cd;color:#856404;\">\n          <i class=\"fa fa-calendar-check-o\"></i> Vencimientos\n        </button>\n        <button onclick=\"window.location.href='/app/catalogo_servicio'\" class=\"ep-btn-sm\" style=\"background:#e8f5e9;color:#2e7d32;\">\n          <i class=\"fa fa-book\"></i> Catálogo Servicios\n        </button>\n        <button onclick=\"window.location.href='/app/plan_contable'\" class=\"ep-btn-sm\" style=\"background:#fce4ec;color:#c62828;\">\n          <i class=\"fa fa-briefcase\"></i> Planes Contables\n        </button>\n        <hr class=\"ep-divider\">\n        <button onclick=\"window.location.href='/app/configuracion-app'\" class=\"ep-btn-sm\" style=\"background:#f3f4f6;color:#444;\">\n          <i class=\"fa fa-cogs\" style=\"color:#f39c12;\"></i> Conf. App\n        </button>\n        <button onclick=\"window.location.href='/app/configuracion_codigo_f29'\" class=\"ep-btn-sm\" style=\"background:#f3f4f6;color:#444;\">\n          <i class=\"fa fa-list-ol\" style=\"color:#1a3a8f;\"></i> C&#243;digos F29\n        </button>\n      </div>\n    </div>\n\n    <!-- COLUMNA 2: MOVIMIENTOS -->\n    <div class=\"col-md-5\" style=\"padding:0 6px;\">\n      <div class=\"ep-section\" style=\"border-top: 4px solid #f39c12;\">\n        <div class=\"ep-section-title\" style=\"color:#e67e22;\">\n          <i class=\"fa fa-exchange\"></i> Movimientos del Mes\n        </div>\n\n        <!-- Ingresos -->\n        <div style=\"background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border-radius:8px;padding:10px 12px;margin-bottom:8px;border-left:4px solid #27ae60;\">\n          <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n            <span style=\"font-size:12px;font-weight:700;color:#1b5e20;\"><i class=\"fa fa-arrow-up\"></i> INGRESOS</span>\n            <span class=\"ep-tag\" style=\"background:#27ae60;color:white;\">VENTAS</span>\n          </div>\n          <button onclick=\"window.location.href='/app/libro_de_ingresos_cliente'\" class=\"ep-btn-main\" style=\"background:#27ae60;color:white;margin-top:8px;margin-bottom:0;\">\n            Libro de Ingresos\n          </button>\n        </div>\n\n        <!-- Egresos -->\n        <div style=\"background:linear-gradient(135deg,#fce4ec,#fdf2f8);border-radius:8px;padding:10px 12px;margin-bottom:8px;border-left:4px solid #c0392b;\">\n          <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n            <span style=\"font-size:12px;font-weight:700;color:#7b1b1b;\"><i class=\"fa fa-arrow-down\"></i> EGRESOS</span>\n            <span class=\"ep-tag\" style=\"background:#c0392b;color:white;\">COMPRAS &amp; GASTOS</span>\n          </div>\n          <div class=\"row\" style=\"margin:0;\">\n            <div class=\"col-xs-6\" style=\"padding:0 3px 4px 0;\"><button onclick=\"window.location.href='/app/libro_de_compras_cliente'\"  class=\"ep-btn-outline rojo\"  style=\"margin:0;\"><i class=\"fa fa-shopping-cart\"></i> Compras</button></div>\n            <div class=\"col-xs-6\" style=\"padding:0 0 4px 3px;\"><button onclick=\"window.location.href='/app/libro_de_honorarios_cliente'\" class=\"ep-btn-outline morado\" style=\"margin:0;\"><i class=\"fa fa-file-text\"></i> Honorarios</button></div>\n          </div>\n          <button onclick=\"window.location.href='/app/libro_de_gastos_cliente'\" class=\"ep-btn-outline naranja\" style=\"margin:0;\"><i class=\"fa fa-ticket\"></i> Gastos sin Factura</button>\n        </div>\n\n        <!-- Remuneraciones -->\n        <button onclick=\"window.location.href='/app/registro_remuneraciones'\" class=\"ep-btn-main\" style=\"background:linear-gradient(135deg,#f39c12,#e67e22);color:white;\">\n          <i class=\"fa fa-address-book\"></i> Registro Remuneraciones\n        </button>\n        <button onclick=\"window.location.href='/app/control_carga'\" class=\"ep-btn-sm\" style=\"background:#f3f4f6;color:#666;text-align:center;\">\n          <i class=\"fa fa-cloud-upload\"></i> Control de Carga Masiva\n        </button>\n      </div>\n    </div>\n\n    <!-- COLUMNA 3: F29 -->\n    <div class=\"col-md-4\" style=\"padding:0 6px;\">\n      <div class=\"ep-section\" style=\"border-top: 4px solid #1a3a8f;\">\n        <div class=\"ep-section-title\" style=\"color:#1a3a8f;\">\n          <i class=\"fa fa-university\"></i> Impuestos &mdash; F29\n        </div>\n\n        <!-- F29 visual strip -->\n        <div style=\"background:linear-gradient(135deg,#1a3a8f,#2980b9);border-radius:8px;padding:12px;margin-bottom:10px;color:white;\">\n          <div style=\"font-size:10px;opacity:0.8;text-transform:uppercase;letter-spacing:1px;\">Formulario SII</div>\n          <div style=\"font-size:18px;font-weight:800;letter-spacing:1px;\">F&#45;29</div>\n          <div style=\"display:flex;gap:5px;margin-top:8px;\">\n            <button onclick=\"window.location.href='/app/declaracion_mensual'\" style=\"flex:2;padding:7px;background:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.4);border-radius:6px;color:white;font-weight:700;font-size:12px;cursor:pointer;\">Declaraci&#243;n Mensual</button>\n            <button onclick=\"window.location.href='/app/borrador_f29'\"        style=\"flex:1;padding:7px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.3);border-radius:6px;color:white;font-size:12px;cursor:pointer;\">Borrador</button>\n          </div>\n        </div>\n\n        <!-- Secciones F29 coloreadas -->\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:8px;\">\n          <div style=\"background:#e3f2fd;border-left:3px solid #1a3a8f;border-radius:5px;padding:6px 8px;\">\n            <div style=\"font-size:9px;color:#1a3a8f;font-weight:700;text-transform:uppercase;\">D&#233;bito</div>\n            <div style=\"font-size:9px;color:#555;\">IVA Ventas</div>\n          </div>\n          <div style=\"background:#e8f5e9;border-left:3px solid #27ae60;border-radius:5px;padding:6px 8px;\">\n            <div style=\"font-size:9px;color:#27ae60;font-weight:700;text-transform:uppercase;\">Cr&#233;dito</div>\n            <div style=\"font-size:9px;color:#555;\">IVA Compras</div>\n          </div>\n          <div style=\"background:#fff8e1;border-left:3px solid #f39c12;border-radius:5px;padding:6px 8px;\">\n            <div style=\"font-size:9px;color:#e67e22;font-weight:700;text-transform:uppercase;\">Retenci&#243;n</div>\n            <div style=\"font-size:9px;color:#555;\">Honorarios</div>\n          </div>\n          <div style=\"background:#fce4ec;border-left:3px solid #e74c3c;border-radius:5px;padding:6px 8px;\">\n            <div style=\"font-size:9px;color:#c0392b;font-weight:700;text-transform:uppercase;\">Impuesto</div>\n            <div style=\"font-size:9px;color:#555;\">Resultante</div>\n          </div>\n        </div>\n\n        <button onclick=\"window.location.href='/app/postergacion_iva'\" class=\"ep-btn-sm\" style=\"background:#fff3e0;color:#e65100;text-align:center;font-weight:600;\">\n          <i class=\"fa fa-clock-o\"></i> Postergaciones IVA\n        </button>\n        <hr class=\"ep-divider\">\n        <div style=\"font-size:10px;font-weight:700;color:#005f6b;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;\">Facturaci&#243;n Propia</div>\n        <button onclick=\"window.location.href='/app/cobranza_cliente'\" class=\"ep-btn-main\" style=\"background:linear-gradient(135deg,#005f6b,#0a8f9e);color:white;margin-bottom:0;\">\n          <i class=\"fa fa-check-circle\"></i> Gesti&#243;n de Cobranza\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ZONA DESARROLLO -->\n  <div class=\"ep-dev\">\n    <div class=\"ep-dev-title\"><i class=\"fa fa-code\"></i> &nbsp;Acceso R&#225;pido Desarrollo (Admin)</div>\n    <table class=\"ep-dev\">\n      <thead>\n        <tr>\n          <td style=\"color:#7fb3c8;font-weight:700;font-size:10px;text-transform:uppercase;\">DocType</td>\n          <td style=\"text-align:center;color:#7fb3c8;font-weight:700;font-size:10px;\">Config</td>\n          <td style=\"text-align:center;color:#7fb3c8;font-weight:700;font-size:10px;\">JS</td>\n          <td style=\"text-align:center;color:#7fb3c8;font-weight:700;font-size:10px;\">PY</td>\n        </tr>\n      </thead>\n      <tbody>\n        <tr><td>Ficha Cliente</td>             <td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/doctype/Ficha_Cliente'\"                 style=\"background:#2d3f50;color:#94a3b8;\"><i class=\"fa fa-wrench\"></i></button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/client-script?dt=Ficha_Cliente'\"                 style=\"background:#78350f;color:#fcd34d;\">JS</button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/server-script?dt=Ficha_Cliente'\"                 style=\"background:#0c4a6e;color:#7dd3fc;\">PY</button></td></tr>\n        <tr><td>Declaraci&#243;n Mensual</td>  <td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/doctype/Declaracion_Mensual'\"            style=\"background:#2d3f50;color:#94a3b8;\"><i class=\"fa fa-wrench\"></i></button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/client-script?dt=Declaracion_Mensual'\"            style=\"background:#78350f;color:#fcd34d;\">JS</button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/server-script?dt=Declaracion_Mensual'\"            style=\"background:#0c4a6e;color:#7dd3fc;\">PY</button></td></tr>\n        <tr><td>Borrador F29</td>             <td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/doctype/Borrador_F29'\"                  style=\"background:#2d3f50;color:#94a3b8;\"><i class=\"fa fa-wrench\"></i></button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/client-script?dt=Borrador_F29'\"                  style=\"background:#78350f;color:#fcd34d;\">JS</button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/server-script?dt=Borrador_F29'\"                  style=\"background:#0c4a6e;color:#7dd3fc;\">PY</button></td></tr>\n        <tr><td>Postergaci&#243;n IVA</td>    <td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/doctype/Postergacion_IVA'\"               style=\"background:#2d3f50;color:#94a3b8;\"><i class=\"fa fa-wrench\"></i></button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/client-script?dt=Postergacion_IVA'\"               style=\"background:#78350f;color:#fcd34d;\">JS</button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/server-script?dt=Postergacion_IVA'\"               style=\"background:#0c4a6e;color:#7dd3fc;\">PY</button></td></tr>\n        <tr><td>Cobranza Cliente</td>         <td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/doctype/Cobranza_Cliente'\"               style=\"background:#2d3f50;color:#94a3b8;\"><i class=\"fa fa-wrench\"></i></button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/client-script?dt=Cobranza_Cliente'\"               style=\"background:#78350f;color:#fcd34d;\">JS</button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/server-script?dt=Cobranza_Cliente'\"               style=\"background:#0c4a6e;color:#7dd3fc;\">PY</button></td></tr>\n        <tr><td>Registro Remuneraciones</td>  <td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/doctype/Registro_Remuneraciones'\"        style=\"background:#2d3f50;color:#94a3b8;\"><i class=\"fa fa-wrench\"></i></button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/client-script?dt=Registro_Remuneraciones'\"        style=\"background:#78350f;color:#fcd34d;\">JS</button></td><td style=\"text-align:center;\"><button class=\"ep-dev-btn\" onclick=\"window.location.href='/app/server-script?dt=Registro_Remuneraciones'\"        style=\"background:#0c4a6e;color:#7dd3fc;\">PY</button></td></tr>\n      </tbody>\n    </table>\n  </div>\n\n</div>",
