  "script": "(function () {\n  frappe.db.count('Ficha_Cliente', { filters: { estado_cliente: 'Activo' } })\n    .then(function (n) {\n      var el = document.getElementById('ep-txt-total-clientes');\n      if (el) el.textContent = n;\n    }).catch(function () {\n      var el = document.getElementById('ep-txt-total-clientes');\n      if (el) el.textContent = '—';\n    });\n}());",
  "style": ""
 }
